# ==============================================================================
# DCF Valuation Platform - Environment Variables Template
# ==============================================================================
# Note: Copy this file to .env or .env.local for local testing.
# NEVER commit your real secrets, API keys, or production credentials.

# ------------------------------------------------------------------------------
# Frontend Settings (Vercel & Next.js)
# ------------------------------------------------------------------------------
# URL of the deployed FastAPI backend (e.g. https://api-dcf.up.railway.app or http://127.0.0.1:8000)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Public Supabase credentials for client-side authentication and session reads
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Default reporting currency configuration (INR / USD)
NEXT_PUBLIC_DEFAULT_CURRENCY=INR

# ------------------------------------------------------------------------------
# Backend Settings (FastAPI & Hosting e.g. Railway / Render / Docker)
# ------------------------------------------------------------------------------
# Environment mode: development / staging / production
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Allowed CORS origins (comma-separated list of origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app

# Secret key for JWT / token verification (if running custom auth alongside Supabase)
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string

# ------------------------------------------------------------------------------
# Supabase Database & Service Role (Backend Server Only - NEVER in browser)
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection string from Supabase (Transaction Pooler or Direct)
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase Service Role Key for privileged backend database operations with RLS bypass where authorized
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# NSE Market Data & Licensing Compliance Gate
# ------------------------------------------------------------------------------
# National Stock Exchange (NSE) MCP endpoints & licensing compliance gate.
# In compliance with NSE Data Policy, commercial SaaS redistribution is disabled by default.
# Set to 'true' ONLY when you hold a verified, signed NSE Market Data Commercial License agreement.
NSE_DATA_LICENSE_APPROVED=false

# NSE MCP Server Endpoints (Official MCP Gateway URLs)
NSE_MCP_CMMKT_URL=https://mcp.nseindia.in/cmmkt/mcp
NSE_MCP_BHAVCOPY_URL=https://mcp.nseindia.in/bhavcopy/cm/mcp
NSE_MCP_TIMEOUT_SECONDS=10

# Optional licensed market data provider API key (e.g. AlphaVantage, EODHD, Finnhub, Bloomberg)
LICENSED_MARKET_DATA_API_KEY=
LICENSED_MARKET_DATA_PROVIDER=none
